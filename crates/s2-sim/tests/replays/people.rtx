!GLOBAL_SET_MAP 200
!GLOBAL_SET_BOBS 0
!GLOBAL_SET_HQ_BOBS 6, 7, 0
!LOAD_MISSION_TEXTS 1
[MAPCOMMANDS]
!SET_HOUSE 24, 33, 39
!ENABLE_ALL_HOUSES
