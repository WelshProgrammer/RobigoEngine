!MET_PEOPLE_AMOUNT    6  255   4     4   -1   -1
!MET_PEOPLE_AMOUNT    7  255  26     1   -1   -1
#        event next times a b c d text text2
!MET_END_EVENT       10  255   3    11 255 255 255    4   -1
!MET_PEOPLE_AMOUNT   11  255   0   150   -1   -1
# Two events that would fire at once, activated and then cleared.
!MET_DIRECT_EVENT    20  255    -1   -1
!MET_PEOPLE_AMOUNT   21  255   0     1   -1   -1
