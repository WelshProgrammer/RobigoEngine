#        event next  text text2
!MET_DIRECT_EVENT     1  255     0   -1
#        event next job amount text text2
!MET_PEOPLE_AMOUNT    2  255   4     3   -1   -1
!MET_PEOPLE_AMOUNT    3   10   0   100   -1   -1
!MET_PEOPLE_AMOUNT    4   10  22    14    2   -1
